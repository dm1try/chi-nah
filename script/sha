#!/usr/bin/env ruby
# frozen_string_literal: true

# Refreshes the sha256 lines in manifest.yml after a plugin or memory edit
# (chi checks them at install, and at Engine start for the plugin).
require "digest"

root = File.expand_path("..", __dir__)
path = File.join(root, "manifest.yml")
text = File.read(path)
section = nil
current = nil
out = text.lines.map do |line|
  if line =~ /\A(\w+):/
    section = Regexp.last_match(1)
    current = nil
  end
  # plugin: has one file (its file: key); files: lists one per key.
  current = Regexp.last_match(1).strip if section == "plugin" && line =~ /\A  file: (.+)/
  current = Regexp.last_match(1) if section == "files" && line =~ /\A  ([\w.-]+):/
  next line unless line =~ /\A(\s+sha256: )sha256:\h*/ && current

  "#{Regexp.last_match(1)}sha256:#{Digest::SHA256.file(File.join(root, current)).hexdigest}\n"
end
File.write(path, out.join)
puts "manifest.yml checksums refreshed"
